FROM rust:1.89-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY libs ./libs
COPY tools/regulatory-corpus/manifest/regulatory-corpus.jsonl ./tools/regulatory-corpus/manifest/regulatory-corpus.jsonl

RUN cargo build --release --package mcp-server --bin rag_ingest

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/rag_ingest /usr/local/bin/rag_ingest
COPY --from=builder /app/tools/regulatory-corpus/manifest/regulatory-corpus.jsonl ./tools/regulatory-corpus/manifest/regulatory-corpus.jsonl

ENTRYPOINT ["/usr/local/bin/rag_ingest"]
