use crate::domain::{AccountActivity, AmlAlert};
use anyhow::Result;
use async_trait::async_trait;
use chrono::{DateTime, Utc};
use rust_decimal::Decimal;
use sqlx::PgPool;

#[async_trait]
pub trait AmlRepository: Send + Sync {
    async fn is_processed(&self, tenant_id: &str, event_id: &str) -> Result<bool>;

    async fn mark_processed(&self, tenant_id: &str, event_id: &str) -> Result<()>;

    async fn create_alert_if_new(&self, alert: &AmlAlert) -> Result<bool>;

    async fn account_activity(
        &self,
        tenant_id: &str,
        account_id: &str,
        since: DateTime<Utc>,
    ) -> Result<AccountActivity>;
}

#[derive(Clone)]
pub struct PostgresAmlRepository {
    pool: PgPool,
}

impl PostgresAmlRepository {
    pub fn new(pool: PgPool) -> Self {
        Self { pool }
    }
}

#[async_trait]
impl AmlRepository for PostgresAmlRepository {
    async fn is_processed(&self, tenant_id: &str, event_id: &str) -> Result<bool> {
        let exists = sqlx::query_scalar::<_, bool>(
            r#"
            SELECT EXISTS (
                SELECT 1
                FROM aml_processed_events
                WHERE tenant_id = $1 AND event_id = $2
            )
            "#,
        )
        .bind(tenant_id)
        .bind(event_id)
        .fetch_one(&self.pool)
        .await?;

        Ok(exists)
    }

    async fn mark_processed(&self, tenant_id: &str, event_id: &str) -> Result<()> {
        sqlx::query(
            r#"
            INSERT INTO aml_processed_events (tenant_id, event_id)
            VALUES ($1, $2)
            ON CONFLICT (tenant_id, event_id) DO NOTHING
            "#,
        )
        .bind(tenant_id)
        .bind(event_id)
        .execute(&self.pool)
        .await?;

        Ok(())
    }

    async fn create_alert_if_new(&self, alert: &AmlAlert) -> Result<bool> {
        let result = sqlx::query(
            r#"
            INSERT INTO aml_alerts (
                id, tenant_id, event_id, transaction_id, rule_code,
                severity, description, details, status, created_at
            )
            VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'open', $9)
            ON CONFLICT (tenant_id, event_id, rule_code) DO NOTHING
            "#,
        )
        .bind(alert.id)
        .bind(&alert.tenant_id)
        .bind(&alert.event_id)
        .bind(alert.transaction_id)
        .bind(&alert.rule_code)
        .bind(&alert.severity)
        .bind(&alert.description)
        .bind(&alert.details)
        .bind(alert.created_at)
        .execute(&self.pool)
        .await?;

        Ok(result.rows_affected() == 1)
    }

    async fn account_activity(
        &self,
        tenant_id: &str,
        account_id: &str,
        since: DateTime<Utc>,
    ) -> Result<AccountActivity> {
        let (transaction_count, total_amount): (i64, Decimal) = sqlx::query_as(
            r#"
            SELECT COUNT(*)::BIGINT, COALESCE(SUM(amount), 0)::NUMERIC
            FROM financial_transactions
            WHERE tenant_id = $1
              AND source_account_id = $2
              AND occurred_at >= $3
            "#,
        )
        .bind(tenant_id)
        .bind(account_id)
        .bind(since)
        .fetch_one(&self.pool)
        .await?;

        Ok(AccountActivity {
            transaction_count,
            total_amount,
        })
    }
}
