FROM rust:1.97-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY libs ./libs

RUN cargo build --release -p aml-service --bin import_regulatory_corpus

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /app/target/release/import_regulatory_corpus /usr/local/bin/import_regulatory_corpus

COPY tools/regulatory-corpus/manifest-pymupdf-ingestion/regulatory-corpus.jsonl /app/regulatory-corpus.jsonl

ENV REGULATORY_MANIFEST=/app/regulatory-corpus.jsonl
ENV OLLAMA_BASE_URL=http://ollama:11434
ENV OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
ENV REGULATORY_EXPECTED_COUNT=129
ENV RUST_LOG=info

ENTRYPOINT ["/usr/local/bin/import_regulatory_corpus"]
